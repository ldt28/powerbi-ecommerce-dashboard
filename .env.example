# Database Configuration (Required)
DATABASE_URL=mysql://username:password@localhost:3306/powerbi_dashboard

# Authentication (Required)
OWNER_OPEN_ID=your-owner-open-id
SESSION_SECRET=your-secret-key-min-32-characters-long

# Server Configuration
NODE_ENV=development
PORT=3000

# AWS S3 Configuration (Optional - for file exports)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Google OAuth (Required for Google Analytics integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Notifications (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password

# Slack Notifications (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
